# Application
APP_NAME=Camera Surveillance AI API
APP_VERSION=0.1.0
DEBUG=false

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Trained model
MODEL_WEIGHTS_PATH=models/training_runs/baseline_yolo11n/weights/best.pt

# Inference
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.50
IMAGE_SIZE=640

# Use:
# DEVICE=cpu
# DEVICE=0 for the first CUDA GPU
# Leave empty for automatic/default selection
DEVICE=

# Upload restrictions
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL=INFO

# Optional camera source
# Never commit a real URL containing a username or password.
CAMERA_SOURCE=0

# Example RTSP format:
# CAMERA_SOURCE=rtsp://username:password@192.168.1.100:554/stream